# CareerCompass BR — Variáveis de ambiente
# Copie para .env e preencha (nunca commite o .env)

# Gupy (portal público SSR — sem auth; 12 vagas/query)
GUPY_BASE_URL=https://portal.gupy.io/job-search

# GeekHunter
GEEKHUNTER_URL=https://www.geekhunter.com.br/vagas

# Programathor
PROGRAMATHOR_URL=https://programathor.com.br/jobs

# Pipeline
MAX_PAGES=3
REQUEST_DELAY=1.5
REQUEST_TIMEOUT=30
USER_AGENT=CareerCompassBot/0.1 (portfolio; +https://github.com/devLeandroCoelho/careercompass-br)

# DuckDB
DUCKDB_PATH=data/warehouse.duckdb
